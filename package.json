{
  "name": "south-end-club-website",
  "version": "1.0.0",
  "description": "South End Club marketing website (standalone repo; exported from WebsiteV1)",
  "scripts": {
    "pretest": "npm run guard",
    "test": "node --test Programs/Pickleball/advanced-open-play/testing/unit/test-openplay-rsvp.js Programs/Pickleball/advanced-open-play/testing/unit/test-firebase-rules.js Programs/Pickleball/advanced-open-play/testing/unit/test-rating-eligibility.js Programs/Pickleball/advanced-open-play/testing/unit/test-roll-live.js",
    "test:pools-instructors": "node Website/Pages/pools/testing/instructor-pill-layout-test.mjs",
    "firebase:deploy-rules": "npx firebase-tools deploy --only database --non-interactive",
    "deploy:openplay": "node Programs/Pickleball/advanced-open-play/scripts/openplay-deploy.js --only hosting",
    "deploy:openplay:all": "node Programs/Pickleball/advanced-open-play/scripts/openplay-deploy.js --only hosting,database",
    "openplay:use-staging": "node Programs/Pickleball/advanced-open-play/scripts/openplay-switch-tree.js staging",
    "openplay:use-live": "node Programs/Pickleball/advanced-open-play/scripts/openplay-switch-tree.js live",
    "openplay:bootstrap-staging": "node Programs/Pickleball/advanced-open-play/scripts/openplay-bootstrap-staging.js",
    "openplay:sync-from-live": "node Programs/Pickleball/advanced-open-play/scripts/openplay-sync-from-live.js",
    "openplay:promote": "node Programs/Pickleball/advanced-open-play/scripts/openplay-promote-staging-to-live.js",
    "roll-live": "node Programs/Pickleball/advanced-open-play/scripts/openplay-roll-live.js",
    "local-test": "npx live-server --port=3456 --open=/Programs/Pickleball/advanced-open-play/testing/local-page/index.html",
    "local-test:sync": "node Programs/Pickleball/advanced-open-play/testing/scripts/local-test.js",
    "local-test:syn": "node Programs/Pickleball/advanced-open-play/testing/scripts/local-test.js",
    "start": "npx live-server --port=3000 --open=/",
    "serve": "npx serve -l 3000",
    "dev": "npx live-server --port=3000 --open=/ --watch=.",
    "convert:local": "node scripts/convert/convert-to-local.js",
    "convert:live": "node scripts/convert/convert-to-local.js --revert",
    "convert:capture": "node scripts/convert/live-capture-to-source.js",
    "check:capture": "node scripts/convert/live-capture-to-source.js --check",
    "audit:capture": "node scripts/convert/live-capture-to-source.js Website/Pages --report Website/Pages/CAPTURE-AUDIT.md",
    "test:capture-converter": "node --test scripts/convert/testing/test-live-capture-to-source.js",
    "build:pickleball-carousel": "node scripts/build/build-carousel.js scripts/build/carousel-configs/pickleball.json",
    "build:tennis-carousel": "node scripts/build/build-carousel.js scripts/build/carousel-configs/tennis.json",
    "scaffold:carousel": "node scripts/scaffold/new-carousel.js",
    "resolve-project-mode": "node scripts/resolve-project-mode.js",
    "summarize": "node Programs/Pickleball/advanced-open-play/scripts/openplay-summarize.js",
    "guard": "npm run guard:membership-pricing && npm run guard:pickleball-header && npm run guard:racquet-promo",
    "guard:membership-pricing": "node scripts/audit/membership-pricing-guard.js",
    "guard:racquet-promo": "node scripts/audit/racquet-promo-guard.js",
    "audit:membership-pricing": "node scripts/audit/membership-pricing-guard.js && node scripts/audit/membership-pricing-audit-pdf.js",
    "pricing:apply": "node scripts/audit/membership-pricing-apply.js",
    "pricing-change": "node scripts/audit/membership-pricing-change.js",
    "guard:pickleball-header": "node scripts/audit/pickleball-header-guard.js"
  },
  "keywords": [
    "south-end-club",
    "fitness",
    "wellness"
  ],
  "author": "South End Club",
  "license": "ISC",
  "devDependencies": {
    "live-server": "^1.2.2",
    "marked": "^17.0.6",
    "pdfkit": "^0.18.0",
    "puppeteer-core": "^24.40.0",
    "serve": "^14.2.1"
  }
}
